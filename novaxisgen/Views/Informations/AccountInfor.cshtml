                            <script>
                                function formatCardNumber(input) {
                                    let value = input.value.replace(/\D/g, '').substring(0, 16);
                                    let formatted = value.replace(/(.{4})/g, '$1-').trim();
                                    if (formatted.endsWith('-')) {
                                        formatted = formatted.slice(0, -1);
                                    }
                                    input.value = formatted;
                                }
                            </script>

                            <script>
                                function mostrarImagemModal(url) {
                                    const modalImg = document.getElementById('imagemModalSrc');
                                    modalImg.src = url;
                                    const modal = new bootstrap.Modal(document.getElementById('imagemModal'));
                                    modal.show();
                                }
                            </script>

                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    // 1) Se houver hash na URL, ativa a aba correspondente
                                    const hash = window.location.hash;
                                    if (hash) {
                                        const trigger =
                                            document.querySelector(`[data-bs-toggle="tab"][href="${hash}"]`) ||
                                            document.querySelector(`[data-bs-toggle="tab"][data-bs-target="${hash}"]`);

                                        if (trigger) {
                                            const tab = bootstrap.Tab.getOrCreateInstance(trigger);
                                            tab.show();

                                            // opcional: rolar até o container de abas
                                            const pane = document.querySelector(hash);
                                            if (pane) pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                        }
                                    }

                                    // 2) Sempre que o usuário trocar de aba, atualiza o hash na URL
                                    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(el => {
                                        el.addEventListener('shown.bs.tab', ev => {
                                            const target = ev.target.getAttribute('data-bs-target') || ev.target.getAttribute('href');
                                            if (target) history.replaceState(null, '', target);
                                        });
                                    });
                                });
                            </script>

                            <script>
                                document.addEventListener('DOMContentLoaded', function () {
                                    const form = document.getElementById('kt_form_endereco');
                                    if (!form) return;

                                    // Campos obrigatórios da aba Location
                                    const FIELD_IDS = ['pais', 'numero', 'rua', 'cidade', 'estado', 'cep'];

                                    form.addEventListener('submit', function (e) {
                                        let firstInvalid = null;

                                        FIELD_IDS.forEach(id => {
                                            const el = document.getElementById(id);
                                            if (!el) return;

                                            const val = (el.value || '').trim();
                                            const wasInvalid = el.classList.contains('is-invalid');

                                            if (!val) {
                                                el.classList.add('is-invalid');

                                                // cria feedback se ainda não existe
                                                if (!el.nextElementSibling || !el.nextElementSibling.classList.contains('invalid-feedback')) {
                                                    const fb = document.createElement('div');
                                                    fb.className = 'invalid-feedback';
                                                    fb.textContent = 'traducao.Required field';
                                                    el.after(fb);
                                                }

                                                if (!firstInvalid) firstInvalid = el;
                                            } else {
                                                el.classList.remove('is-invalid');
                                                if (el.nextElementSibling && el.nextElementSibling.classList.contains('invalid-feedback')) {
                                                    el.nextElementSibling.remove();
                                                }
                                            }

                                            // Se acabou de ficar inválido, remove estado inválido ao digitar
                                            if (!wasInvalid) {
                                                el.addEventListener('input', () => {
                                                    if ((el.value || '').trim()) {
                                                        el.classList.remove('is-invalid');
                                                        if (el.nextElementSibling && el.nextElementSibling.classList.contains('invalid-feedback')) {
                                                            el.nextElementSibling.remove();
                                                        }
                                                    }
                                                }, { once: true });
                                            }
                                        });

                                        if (firstInvalid) {
                                            e.preventDefault();                 // bloqueia o submit
                                            firstInvalid.focus({ preventScroll: false });
                                        }
                                    });
                                });
                            </script>



