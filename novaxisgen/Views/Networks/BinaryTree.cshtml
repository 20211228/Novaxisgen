                            <script>
                                function selectPerna(el) {
                                    document.querySelectorAll('.option-card').forEach(card => card.classList.remove('active'));
                                    el.classList.add('active');
                                    document.getElementById('selected_perna').value = el.getAttribute('data-value');
                                }

                                // Apply previously selected value
                                document.addEventListener('DOMContentLoaded', () => {
                                    const current = document.getElementById('selected_perna').value;
                                    if (current) {
                                        const target = document.querySelector(`.option-card[data-value="${current}"]`);
                                        if (target) target.classList.add('active');
                                    }
                                });
                            </script>

