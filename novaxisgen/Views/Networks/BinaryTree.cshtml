                                                            if (!root || !openBt || !video) return;

                                                            // Portal para <body> (evita herdar opacity/transform dos pais)
                                                            if (root.parentElement !== document.body) document.body.appendChild(root);

                                                            const overlay = root.querySelector('.hv-overlay');
                                                            const dialog = root.querySelector('.hv-dialog');
                                                            const closeTop = root.querySelector('.hv-close-top');
                                                            const closeNice = root.querySelector('.js-hv-close');

                                                            const lockScroll = () => { document.documentElement.classList.add('hv-lock'); document.body.classList.add('hv-lock'); };
                                                            const freeScroll = () => { document.documentElement.classList.remove('hv-lock'); document.body.classList.remove('hv-lock'); };

                                                            function show() {
                                                                root.classList.add('hv-open');
                                                                root.setAttribute('aria-hidden', 'false');
