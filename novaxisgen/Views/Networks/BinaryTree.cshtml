    <script>
    // Lấy sponsorId từ Session
    const sponsorId = '@Context.Session.GetString("ID")';

    function showPopup(userId, username) {
        const popup = document.getElementById("popup");
        document.getElementById("popupInfo").innerText = `Vị trí: ${username} (ID: ${userId})`;
        popup.style.display = "block";

        const baseUrl = window.location.origin + "/Logins/SignUp";
        document.getElementById("btnLeft").onclick = () => copyLink(`${baseUrl}?sponsorId=${sponsorId}&placementId=${userId}&nhanh=left`);
        document.getElementById("btnRight").onclick = () => copyLink(`${baseUrl}?sponsorId=${sponsorId}&placementId=${userId}&nhanh=right`);
    }

    function copyLink(link) {
        navigator.clipboard.writeText(link).then(() => {
            alert("✅ Đã copy link: " + link);
        });
        closePopup();
    }

    function closePopup() {
        document.getElementById("popup").style.display = "none";
    }
</script>









    @functions {
    // === Hàm tính độ sâu cây ===
    private int GetTreeDepth(CayNhiPhanViewModel node)
    {
        if (node == null) return 0;
        int leftDepth = GetTreeDepth(node.Trai);
        int rightDepth = GetTreeDepth(node.Phai);
        return Math.Max(leftDepth, rightDepth) + 1;
    }

    // === Hàm render cây nhị phân ===
    private string RenderBinaryTree(CayNhiPhanViewModel root)
    {
        if (root == null) return "";
        int maxDepth = GetTreeDepth(root);

        var rows = new List<string>();
        BuildLevel(new List<CayNhiPhanViewModel> { root }, 1, maxDepth, rows);
        return string.Join("", rows);
    }

    private void BuildLevel(List<CayNhiPhanViewModel> nodes, int level, int maxDepth, List<string> rows)
    {
        if (nodes.Count == 0) return;
        int colspan = (int)Math.Pow(2, maxDepth - level);

        // Hàng hiện tại
        var html = "<tr>";
        foreach (var node in nodes)
        {
            html += $"<td colspan='{colspan}' style='text-align:center; border-color:white;'>";
            html += BuildUserHtml(node);
            html += "</td>";
        }
        html += "</tr>";
        rows.Add(html);

        // Hàng nối
        var connectHtml = "<tr>";
        foreach (var node in nodes)
        {
            connectHtml += $"<td colspan='{colspan}' style='text-align:center; height:20px; border-color:white;'>";
            if (node != null && (node.Trai != null || node.Phai != null))
            {
                connectHtml += "<div style='height:20px; border-left:1px solid white; border-right:1px solid white;'></div>";
            }
            connectHtml += "</td>";
        }
        connectHtml += "</tr>";
        rows.Add(connectHtml);

        var nextLevelNodes = new List<CayNhiPhanViewModel>();
        foreach (var node in nodes)
        {
            if (node == null)
            {
                nextLevelNodes.Add(null);
                nextLevelNodes.Add(null);
            }
            else
            {
                nextLevelNodes.Add(node.Trai);
                nextLevelNodes.Add(node.Phai);
            }
        }

        if (nextLevelNodes.Any(n => n != null))
        {
            BuildLevel(nextLevelNodes, level + 1, maxDepth, rows);
        }
    }

    // === Render node người dùng ===
    private string BuildUserHtml(CayNhiPhanViewModel user)
    {
        if (user == null)
        {
            return "<div style='text-align:center;'>" +
                   "<a rel='popover' data-toggle='popover' href='#'>" +
                   "<img class='avatar-binario' src='/Image/pacotes/empty.png'>" +
                   "<span style='color: white;'>Trống</span>" +
                   "</a></div>";
        }

        return $@"
        <div style='text-align:center;'>
            <a href='#' onclick=""showPopup('{user.UserId}', '{user.Username}')"" style='text-decoration:none;'>
                <img class='avatar-binario' src='/Image/pacotes/empty.png'>
                <span style='color: white;'>{user.Username}</span>
            </a>
        </div>";
    }
}






