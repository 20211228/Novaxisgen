                            <script>
                                (function () {
                                    const modalId = "genesisVideosModal";
                                    const modalEl = document.getElementById(modalId);
                                    const player = document.getElementById(modalId + 'Video');
                                    if (!modalEl || !player) return;

                                    // Base das thumbs agora em /img/thumbs
                                    const posterBase = "https://genesis-tech.net/img/thumbs"; // /img/thumbs

                                    function getModalInstance(el) {
                                        try {
                                            return (window.bootstrap && window.bootstrap.Modal)
                                                ? window.bootstrap.Modal.getOrCreateInstance(el)
                                                : null;
                                        } catch { return null; }
                                    }

                                    modalEl.addEventListener('show.bs.modal', function (e) {
                                        const trigger = e.relatedTarget;
                                        const currentSrc = trigger ? trigger.getAttribute('data-video-src') : '';

                                        // Limpa estado anterior
                                        try { player.pause(); } catch { }
                                        player.removeAttribute('src');
                                        player.load();

                                        if (!currentSrc) return;

                                        // Deriva poster: .../x.mp4 -> /img/thumbs/x.png
                                        const file = currentSrc.split('/').pop().split('?')[0]; // ex: ch-1.mp4
                                        const base = file.replace(/\.[^.]+$/, '');              // ex: ch-1
                                        const poster = `${posterBase}/${base}.png`;
                                        player.setAttribute('poster', poster);

                                        // Define o src e tenta reproduzir
                                        player.src = currentSrc;

                                        const tryPlay = () => {
                                            try {
                                                const p = player.play();
                                                if (p && typeof p.catch === 'function') {
                                                    p.catch(() => { player.muted = true; player.play().catch(() => { }); });
                                                }
                                            } catch {
                                                player.muted = true;
                                                try { player.play(); } catch { }
                                            }
                                        };

                                        if (player.readyState >= 1) {
                                            tryPlay();
                                        } else {
                                            player.addEventListener('loadedmetadata', function onMeta() {
                                                player.removeEventListener('loadedmetadata', onMeta);
                                                tryPlay();
                                            });
                                            try { player.load(); } catch { }
                                        }
                                    });

                                    modalEl.addEventListener('hidden.bs.modal', function () {
                                        try { player.pause(); } catch { }
                                        player.removeAttribute('src');
                                        player.load();
                                        player.muted = false;
                                    });

                                    modalEl.addEventListener('click', function (e) {
                                        const closeBtn = e.target.closest('[data-bs-dismiss="modal"]');
                                        if (!closeBtn) return;
                                        const inst = getModalInstance(modalEl);
                                        if (inst) inst.hide();
                                    });
                                })();
                            </script>

