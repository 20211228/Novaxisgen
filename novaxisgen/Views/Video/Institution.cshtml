    <script>
        (function () {
            // ============ Núcleo do Tema ============
            const KEY = "data-bs-theme";
            const html = document.documentElement;

            function preferSystem() {
                try { return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                catch (_) { return 'dark'; }
            }
            function current() {
                return html.getAttribute('data-bs-theme') || localStorage.getItem(KEY) || preferSystem();
            }
            function apply(theme) {
                html.setAttribute('data-bs-theme', theme);
                try { localStorage.setItem(KEY, theme); } catch (_) { }

                // Atualiza labels e ícones (desktop + mobile)
                const isDark = theme === 'dark';
                const fixedBtn = document.getElementById('themeToggleFixed');
                const fixedLbl = document.getElementById('themeLabelFixed');
                const fixedIcon = fixedBtn ? fixedBtn.querySelector('.theme-icon') : null;

                const mobileBtn = document.getElementById('themeToggleMobile');
                const mobileLbl = document.getElementById('themeLabelMobile');
                const mobileIcon = mobileBtn ? mobileBtn.querySelector('.theme-icon') : null;

                if (fixedLbl) fixedLbl.textContent = isDark ? 'Dark' : 'Light';
                if (mobileLbl) mobileLbl.textContent = isDark ? 'Dark' : 'Light';
                if (fixedBtn) fixedBtn.setAttribute('aria-checked', isDark ? 'true' : 'false');
                if (mobileBtn) mobileBtn.setAttribute('aria-checked', isDark ? 'true' : 'false');
                if (fixedIcon) fixedIcon.textContent = isDark ? '🌙' : '☀️';
                if (mobileIcon) mobileIcon.textContent = isDark ? '🌙' : '☀️';
            }
            function toggle() {
                const next = (html.getAttribute('data-bs-theme') || current()) === 'dark' ? 'light' : 'dark';
                apply(next);
            }

            // Expõe globais estáveis (sobrepõe os antigos)
            window.__applyTheme = apply;
            window.__toggleTheme = function (ev) { if (ev) { ev.preventDefault(); ev.stopPropagation(); } toggle(); return false; };

            // ============ Monta o item no submenu mobile ============
            function ensureMobileToggle() {
                // raiz do menu do drawer mobile
                const menuRoot = document.querySelector('[data-kt-drawer-name="header-menu"] .menu[data-kt-menu="true"]')
                    || document.querySelector('.menu[data-kt-menu="true"]');
                if (!menuRoot) return;
                if (document.getElementById('themeToggleMobile')) return; // já existe

                // cria item no padrão do menu
                const item = document.createElement('div');
                item.className = 'menu-item d-lg-none mt-3'; // só aparece no mobile
                item.innerHTML = `
              <a id="themeToggleMobile"
                 href="#"
                 class="menu-link py-3"
                 role="switch"
                 aria-checked="true"
                 data-kt-menu-dismiss="false">
                <span class="theme-icon me-2">🌙</span>
                <span class="menu-title"><strong id="themeLabelMobile">Dark</strong></span>
              </a>
            `;

                // insere logo após o botão "WATCH BOOSTERS" se existir; senão, no fim da lista
                const watchBtn = menuRoot.querySelector('.btn-boost-modern');
                if (watchBtn && watchBtn.parentNode === menuRoot) {
                    watchBtn.insertAdjacentElement('afterend', item);
                } else {
                    menuRoot.appendChild(item);
                }
            }

            // ============ Comportamento por viewport ============
            const mq = window.matchMedia('(max-width: 991.98px)'); // breakpoint lg do Bootstrap

            function placeByViewport() {
                const fixedBtn = document.getElementById('themeToggleFixed');
                if (mq.matches) {
                    ensureMobileToggle();                  // garante o item no menu lateral mobile
                    if (fixedBtn) fixedBtn.style.display = 'none'; // esconde botão flutuante no mobile
                } else {
                    if (fixedBtn) fixedBtn.style.display = 'inline-flex'; // mostra botão flutuante no desktop
                    // o item mobile tem 'd-lg-none', então some no desktop automaticamente
                }
            }

            // ============ Clique robusto (funciona dentro do drawer) ============
            function onClick(ev) {
                const t = ev.target && ev.target.closest && ev.target.closest('#themeToggleMobile, #themeToggleFixed');
                if (!t) return;
                ev.preventDefault();
                ev.stopPropagation(); // impede o drawer de "engolir" o evento
                toggle();
            }
            ['pointerdown', 'click', 'touchstart'].forEach(evt => window.addEventListener(evt, onClick, true));

            // Inicializa estado e posicionamento
            apply(current());
            placeByViewport();
            if (mq.addEventListener) mq.addEventListener('change', placeByViewport);
            else if (mq.addListener) mq.addListener(placeByViewport);
        })();
    </script>

