                            <style>
                                .yt-grid .thumb {
                                    position: relative;
                                    border-radius: 12px;
                                    overflow: hidden;
                                    background: #000;
                                    border: 1px solid #2a2a2a;
                                    transition: transform .15s,box-shadow .15s
                                }

                                    .yt-grid .thumb:hover {
                                        transform: translateY(-2px);
                                        box-shadow: 0 10px 28px rgba(0,0,0,.35)
                                    }

                                    .yt-grid .thumb .overlay {
                                        position: absolute;
                                        inset: 0;
                                        display: grid;
                                        place-items: center;
                                        background: linear-gradient(to top,rgba(0,0,0,.45),rgba(0,0,0,.05));
                                        opacity: 0;
                                        transition: opacity .15s
                                    }

                                    .yt-grid .thumb:hover .overlay {
                                        opacity: 1
                                    }

                                .yt-grid .play-btn {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: 50%;
                                    background: rgba(0,255,255,.18);
                                    border: 2px solid #00ffff;
                                    display: grid;
                                    place-items: center
                                }

                                    .yt-grid .play-btn i {
                                        border-style: solid;
                                        border-width: 12px 0 12px 20px;
                                        border-color: transparent transparent transparent #00ffff;
                                        margin-left: 4px
                                    }

                                /* Poster da grade */
                                .video-poster {
                                    width: 100%;
                                    height: 100%;
                                    object-fit: contain;
                                    background: #000;
                                    display: block;
                                }

                                #genesisVideosModal .btn-close {
                                    position: absolute;
                                    z-index: 1061;
                                }
                            </style>

