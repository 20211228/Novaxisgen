  :root[data-bs-theme="light"] #kt_header{ background:transparent !important; }

  :root[data-bs-theme="light"] .card,
  :root[data-bs-theme="light"] .modal-content,
  :root[data-bs-theme="light"] .dropdown-menu,
  :root[data-bs-theme="light"] .menu-sub{
    background:#fff !important;
    color:#111 !important;
    border:1px solid #e5e7eb !important;
    box-shadow:0 10px 24px rgba(15,17,18,.06);
  }
  :root[data-bs-theme="light"] .card :is(p, span, li, div, small, strong, em, a, button, label, h1, h2, h3, h4, h5, h6),
  :root[data-bs-theme="light"] .modal-content :is(p, span, li, div, small, strong, em, a, button, label, h1, h2, h3, h4, h5, h6),
  :root[data-bs-theme="light"] .dropdown-menu :is(p, span, li, div, small, strong, em, a, button, label, h1, h2, h3, h4, h5, h6),
  :root[data-bs-theme="light"] .menu-sub :is(.menu-link, .menu-item, .menu-title){
    color:#111 !important;
  }
  :root[data-bs-theme="light"] .card .text-white,
  :root[data-bs-theme="light"] .modal-content .text-white,
  :root[data-bs-theme="light"] .dropdown-menu .text-white,
  :root[data-bs-theme="light"] .menu-sub .text-white{
    color:#111 !important;
  }
  :root[data-bs-theme="light"] .card .form-control,
