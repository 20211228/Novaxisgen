  /* Keep space background interactive off and behind everything */
  #space { z-index: 0; pointer-events: none; }

  /* Ensure header and toggle are clickable above overlays */
  #kt_header { position: relative; z-index: 1040; }
  #themeToggleFixed { pointer-events: auto !important; }


  :root[data-bs-theme="light"] body{ background:#000 !important; color:#e6eef7 !important; }
