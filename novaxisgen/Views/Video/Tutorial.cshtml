<style>
/* ===== estilos escopados ===== */
.genesis-tuts .card{ background:#0e1116; border:1px solid rgba(255,255,255,.08); border-radius:16px; }
.genesis-tuts .card-header{ border-bottom:1px solid rgba(255,255,255,.08); background:transparent; }
.genesis-tuts .card-header .title{ font-weight:700; letter-spacing:.2px; margin:0 auto; }

.genesis-tuts .player-wrap{ border-radius:14px; overflow:hidden; background:#000; }
.genesis-tuts .player-aspect{ aspect-ratio:16/9; }
@@media (min-width: 992px){ .genesis-tuts .player-aspect{ aspect-ratio:auto; height:62vh; } }

.genesis-tuts .main-title{
  display:flex; justify-content:center; align-items:center; gap:.6rem;
  margin-top:.8rem; color:#e6f2f2; font-weight:600; text-align:center; width:100%;
}
.genesis-tuts .main-title .title-text{ display:inline-block; text-align:center; }
.genesis-tuts .main-title .loading{ display:none; gap:.45rem; align-items:center; color:#8bdada; font-size:.9rem; }
.genesis-tuts .main-title .loading.show{ display:inline-flex; }

/* playlist embaixo (horizontal) */
.genesis-tuts .playlist-rail{
  display:flex; gap:.9rem; overflow-x:auto; overflow-y:hidden; padding:.6rem .25rem 1rem;
  scroll-snap-type:x mandatory; border-top:1px solid rgba(255,255,255,.08); margin-top:1rem;
}
.genesis-tuts .playlist-rail::-webkit-scrollbar{ height:10px; }
.genesis-tuts .playlist-rail::-webkit-scrollbar-thumb{ background:rgba(0,255,255,.25); border-radius:10px; }
.genesis-tuts .playlist-rail::-webkit-scrollbar-track{ background:rgba(255,255,255,.06); border-radius:10px; }

.genesis-tuts .pl-item{
  scroll-snap-align:start;
  flex:0 0 240px;
  display:flex; gap:.75rem; align-items:center;
  padding:.55rem; border-radius:12px; border:1px solid transparent; cursor:pointer; transition:.15s ease;
  background:rgba(255,255,255,.02);
}
.genesis-tuts .pl-item:hover{ background:rgba(0,255,255,.06); border-color:#143a3a; }
.genesis-tuts .pl-item.active{ background:rgba(0,255,255,.12); border-color:#00ffff; }

.genesis-tuts .pl-thumb{ width:110px; aspect-ratio:16/9; border-radius:10px; overflow:hidden; background:#000; flex:0 0 auto; }
.genesis-tuts .pl-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
.genesis-tuts .pl-meta{ min-width:0; }
.genesis-tuts .pl-name{ color:#dff; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.genesis-tuts .pl-lang{ display:inline-block; font-size:.7rem; padding:.12rem .45rem; border:1px solid rgba(255,255,255,.12); border-radius:6px; margin-top:.25rem; color:#8bdada; }
</style>

