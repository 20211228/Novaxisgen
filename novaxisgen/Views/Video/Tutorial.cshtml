<script>
(function () {
  const playerId    = "genesisTutorialsPlayer";
  const playlistId  = "genesisTutorialsPlaylist";
  const titleTextId = "genesisTutorialsPlayerTitleText";
  const loadingId   = "genesisTutorialsPlayerLoading";

  const video     = document.getElementById(playerId);
  const rail      = document.getElementById(playlistId);
  const titleText = document.getElementById(titleTextId);
  const loading   = document.getElementById(loadingId);

  if (!video || !rail || !titleText) return;

  const setActive = (item) => {
    rail.querySelectorAll('.pl-item').forEach(el => el.classList.remove('active'));
    item?.classList.add('active');
  };

  const loadVideo = (src, poster, title) => {
    if (!src) return;

    titleText.textContent = title || '';
    loading?.classList.add('show');

    try { video.pause(); } catch {}
    video.removeAttribute('src');
    if (poster) video.setAttribute('poster', poster);
    try { video.load(); } catch {}

    video.setAttribute('src', src);

    const onMeta = () => {
      video.removeEventListener('loadedmetadata', onMeta);
      loading?.classList.remove('show');
      try {
        const p = video.play();
        if (p && typeof p.catch === 'function') p.catch(()=>{});
      } catch {}
    };
    video.addEventListener('loadedmetadata', onMeta);
    try { video.load(); } catch {}
  };

  rail.addEventListener('click', (e) => {
    const item = e.target.closest('.pl-item');
    if (!item) return;
    setActive(item);
    item.scrollIntoView({inline:'center', behavior:'smooth', block:'nearest'});
    loadVideo(item.dataset.src, item.dataset.poster, item.dataset.title);
  });

  // Navegação por teclado
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const items = Array.from(rail.querySelectorAll('.pl-item'));
    const idx = items.findIndex(i => i.classList.contains('active'));
    if (idx < 0) return;
    const nextIdx = e.key === 'ArrowRight' ? Math.min(idx+1, items.length-1) : Math.max(idx-1, 0);
    const target = items[nextIdx];
    if (target) { target.scrollIntoView({inline:'center', behavior:'smooth'}); target.click(); }
  });
})();
</script>
