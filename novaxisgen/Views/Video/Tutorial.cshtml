<style>
/*CSS Ref ao tema dark e light */
	html[data-bs-theme="dark"] #space {
	background-color: #000000ff !important;
	}

	/* Torna o fundo branco no light */
	html[data-bs-theme="light"] #space {
	background-color: #ffffffff !important;
	}
		/* Garante clique mesmo com overlays do header */
	#kt_header { position: relative; z-index: 1040; }
	#themeToggle { position: relative; z-index: 1045; pointer-events: auto !important; }
	:root{
		--bg:#0b0d12; --text:#e6eef7; --card:#121722; --border:#21283a;
		--brand:#00ffe1; --brand-2:#00d1ff; --menu-text:#00f0ff;
		--menu-hover-bg:rgba(0,255,255,.08); --menu-hover-text:#fff;
	}
	/* Dark (mantém seu visual atual) */
	[data-bs-theme="dark"] body{background:var(--bg);color:var(--text);}
	[data-bs-theme="dark"] .card{background:var(--card);border:1px solid var(--border);}
	[data-bs-theme="dark"] .menu-link{color:var(--menu-text)!important;}
	[data-bs-theme="dark"] .menu-link:hover{background:var(--menu-hover-bg);color:var(--menu-hover-text)!important;}
	[data-bs-theme="dark"] .btn-withdraw-clean{background:#1e1e2d;color:var(--brand);border:1px solid var(--brand);}
	[data-bs-theme="dark"] .btn-withdraw-clean:hover{background:var(--brand);color:#1e1e2d;box-shadow:0 0 8px var(--brand);}
	[data-bs-theme="dark"] .header-logo img{filter:drop-shadow(0 0 4px var(--brand));}
	[data-bs-theme="dark"] #space{opacity:.8;}

	/* Light (overrides mínimos para manter “o clima”) */
	[data-bs-theme="light"] body{background:#f7f9fc;color:#111;}
	[data-bs-theme="light"] .card{background:#fff;border:1px solid #e5e7eb;}
	[data-bs-theme="light"] .menu-sub{background:rgba(255,255,255,.95)!important;border:1px solid #e9ecef;box-shadow:0 10px 24px rgba(15,17,18,.06);}
