	[data-bs-theme="light"] .btn-boost-modern{background:rgba(0,153,204,.08);border:1px solid rgba(0,153,204,.25);color:#007592;}
	[data-bs-theme="light"] .btn-boost-modern:hover{background:rgba(0,153,204,.15);color:#003b46;}
