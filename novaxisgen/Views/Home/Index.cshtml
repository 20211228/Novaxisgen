<script>
  document.addEventListener('DOMContentLoaded', () => {
    const formatUSD = (val) => {
      const n = Number.isFinite(val) ? val : 0;
      try {
        return n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
      } catch {
        return '$' + n.toFixed(2);
      }
    };

    function animateValue(el, target, duration = 1000) {
      const end = Number.isFinite(target) ? target : 0;
      let startTs = null;
      const step = (ts) => {
        if (!startTs) startTs = ts;
        const p = Math.min((ts - startTs) / duration, 1);
        el.textContent = formatUSD(end * p);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    ['bonusBalance', 'roiBalance', 'gamesBalance'].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      const raw = parseFloat(el.dataset.valor);
      const val = Number.isFinite(raw) ? raw : 0;
      animateValue(el, val);
    });
  });
</script>

