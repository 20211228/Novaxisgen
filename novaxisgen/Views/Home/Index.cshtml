<style>
/* ====== Wrapper / Cores herdadas do projeto ====== */
.news-wrapper .news-count{ background: rgba(59,130,246,.15); }
[data-bs-theme="light"] .news-wrapper .news-count{ background: rgba(59,130,246,.12); }

/* Altura rolável do card grande (ajuste se quiser mais/menos linhas visíveis) */
.news-scroll{
    max-height: 680px;       /* mantém os cards pequenos visíveis em várias linhas */
    overflow-y: auto;
    padding-right: .25rem;
}
.news-scroll::-webkit-scrollbar{ width: 8px; }
.news-scroll::-webkit-scrollbar-thumb{
    background: rgba(148,163,184,.35);
    border-radius: 8px;
}
[data-bs-theme="light"] .news-scroll::-webkit-scrollbar-thumb{
    background: rgba(100,116,139,.35);
}

/* ====== Card pequeno ====== */
.news-card{
    background: var(--kt-card-bg, #0f172a);
    border: 1px solid var(--kt-border-color, rgba(148,163,184,.22));
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0,0,0,.18);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
[data-bs-theme="light"] .news-card{
    background: #fff;
    box-shadow: 0 8px 22px rgba(0,0,0,.08);
}
.news-card:hover{
    transform: translateY(-2px);
    border-color: rgba(59,130,246,.35);
    box-shadow: 0 12px 26px rgba(0,0,0,.24);
}

/* Thumb (imagem) */
.news-thumb{
    position: relative;
    height: 168px;           /* mantém o card compacto */
    overflow: hidden;
    cursor: pointer;
}
.news-thumb img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .25s ease;
}
.news-card:hover .news-thumb img{ transform: scale(1.05); }
.news-thumb-overlay{
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,.25));
    pointer-events: none;
}

/* Conteúdo */
.news-meta{ padding: 12px 14px 14px 14px; }
.news-source{ font-size: .8rem; font-weight: 600; color: var(--kt-text-muted, #94a3b8); }
.news-date{ font-size: .8rem; color: var(--kt-text-muted, #94a3b8); display: inline-flex; align-items: center; gap: 4px; }

.news-title{
    font-weight: 700;
    margin: 6px 0 4px;
    line-height: 1.2;
}
.news-title:hover{ text-decoration: underline; text-underline-offset: 2px; }

.news-desc{
    font-size: .88rem;
