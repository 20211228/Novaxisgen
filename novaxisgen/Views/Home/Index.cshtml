@{

    // Lấy URL gốc của website (http hoặc https)
    string baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";

    // Giả sử bạn lưu ID người dùng vào Session sau khi đăng nhập
    var userId = Context.Session.GetString("ID");

    // Nếu có user đang đăng nhập thì tạo link trái / phải
    string traiLink = "";
    string phaiLink = "";
    if (userId != null)
    {
        var UserID = long.Parse(userId);
        traiLink = $"{baseUrl}/Logins/SignUp?nhanh=Trai&chaId={UserID}";
        phaiLink = $"{baseUrl}/Logins/SignUp?nhanh=Phai&chaId={UserID}";
    }


}


