<script>
(function() {
    const root = document.getElementById("logged-users-card-2ba65828-bc8c-4d8e-8479-593b1b3cf90f");
    if (!root || root.dataset.enhanced === '1') return;
    root.dataset.enhanced = '1';

    // Injeta CSS da animação sutil (uma única vez)
    if (!document.getElementById('logged-users-card-style')) {
        const st = document.createElement('style');
        st.id = 'logged-users-card-style';
        st.textContent = `
            .soft-add {
                opacity: 0;
                transform: translateY(-6px);
                transition: opacity .35s ease, transform .35s ease;
            }
            .soft-add.show {
                opacity: 1;
                transform: translateY(0);
            }
        `;
        document.head.appendChild(st);
    }

    const LIST = root.querySelector('.js-logged-users-list');

    // === casar a altura com o Invite Card ===
    function matchHeight() {
        const invite = document.querySelector('#invite-card, .invite-card, [data-invite-card="1"]');
        const fallback = 360;
        let target = fallback;
        if (invite) {
            const r = invite.getBoundingClientRect();
            if (r && r.height > 0) target = Math.round(r.height);
        }
        root.style.height = target + 'px';
    }
    const inviteCandidate = document.querySelector('#invite-card, .invite-card, [data-invite-card="1"]');
    if (inviteCandidate && 'ResizeObserver' in window) {
        const ro = new ResizeObserver(matchHeight);
        ro.observe(inviteCandidate);
        root._resizeObserver = ro;
    }
    window.addEventListener('resize', matchHeight);
    matchHeight();

    // === mapa de idiomas ===
    const langMap = {
        en: 'English', es: 'Español', cn: '中文', vn: 'Tiếng Việt',
        jp: '日本語', kr: '한국어', ru: 'русский', fr: 'Français', de: 'Deutsch',
    };

    // Mantém as chaves já exibidas para não reexibir
    // Usamos "login" como chave (se vier objeto) ou a própria string (se vier só o login)
    const seen = new Set();

    function formatDate(dtStr) {
        if (!dtStr) return '';
        try {
            const d = new Date(dtStr.replace(' ', 'T'));
            const pad = n => String(n).padStart(2, '0');
            return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
        } catch { return dtStr; }
    }

    // Normaliza item da API para um objeto padrão
    function normalize(row) {
        if (typeof row === 'string') {
            // Sem timestamp não dá pra distinguir atualizações
            return {
                key: `login:${row}|dt:`,
                login: row,
                lang: null,
                lastAt: ''
            };
        }

        const login = row.login ?? 'N/A';
        const lang  = row.lang ?? null;

        // use SEMPRE a string crua do banco (sem formatar) para compor a chave
        const rawDt = row.data_hora_login ?? row.last_at ?? null;

        // chave de dedup: login + timestamp
        const key = `login:${login}|dt:${rawDt ?? ''}`;

        // formata só para exibição
        const lastAt = rawDt ? formatDate(rawDt) : '';

        return { key, login, lang, lastAt };
    }

    function makeLi(item) {
        const langName = item.lang ? (langMap[item.lang] ?? item.lang) : null;
        const flagSrc  = item.lang ? `/Image/flags/${item.lang}.svg` : null;

        const li = document.createElement('li');
        li.className = 'd-flex justify-content-between align-items-center bg-dark bg-opacity-10 p-3 rounded mb-2 soft-add';
        li.dataset.key = item.key;

        const left = document.createElement('div');
        left.className = 'fs-6';
        left.innerHTML = `
            A new visitor in Genesis - <strong>${item.login}</strong>
            ${item.lang ? `
                - With language
                <span class="ms-2 d-inline-flex align-items-center">
                    <img class="me-2" style="width:15px;height:15px;border-radius:2px" src="${flagSrc}" alt="${langName}">
                    <span>${langName}</span>
                </span>
            ` : ``}
        `;

        const right = document.createElement('small');
        right.className = 'text-muted';
        right.textContent = item.lastAt || '';

        li.appendChild(left);
        li.appendChild(right);
        return li;
    }

    function prependSoft(li) {
        // remove placeholder se existir
        const placeholder = LIST.querySelector('.js-placeholder');
        if (placeholder) placeholder.remove();

        // Preprende mantendo rolagem suave (não força scroll)
        LIST.insertBefore(li, LIST.firstChild);
        // força reflow para a transição
        requestAnimationFrame(() => li.classList.add('show'));

        // mantém no máximo 50 itens
        while (LIST.children.length > 50) {
            LIST.lastElementChild.remove();
        }
    }

    function initialRender(items) {
        LIST.innerHTML = '';
        if (!items.length) {
            const li = document.createElement('li');
            li.className = 'text-muted text-center js-placeholder';
            li.textContent = "Kh\u00f4ng c\u00f3 b\u1ea3n ghi";
            LIST.appendChild(li);
            return;
        }
        const frag = document.createDocumentFragment();
        items.forEach(item => {
            seen.add(item.key);
            const li = makeLi(item);
            li.classList.add('show'); // já aparece visível no primeiro render
            frag.appendChild(li);
        });
        LIST.appendChild(frag);
    }

    let firstLoad = true;

    async function fetchLogins() {
        try {
            const res = await fetch("https:\/\/genesis-tech.net\/loggedusers", {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
                cache: 'no-store',
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);

            const raw = await res.json();
            const all = Array.isArray(raw) ? raw.map(normalize) : [];

            // primeira carga: renderiza a lista e popula "seen"
            if (firstLoad) {
                firstLoad = false;
                initialRender(all);
                return;
            }

            // cargas seguintes: pega apenas os "novos" (não vistos)
            // assumindo que a rota vem ordenada DESC por data_hora_login
            const newOnes = all.filter(it => !seen.has(it.key));
            if (!newOnes.length) return;

            // adiciona os novos do mais recente para o menos recente (já deve estar nessa ordem)
            newOnes.forEach(it => {
                seen.add(it.key);
                prependSoft(makeLi(it));
            });

        } catch (err) {
            // Não zera a lista em erro; apenas loga
            console.error('loggedUsers fetch error:', err);
        }
    }

    // Primeiro fetch + polling cada 3s
    fetchLogins();
    const intervalId = setInterval(fetchLogins, 3000);
    root.dataset.intervalId = intervalId;
})();
</script>
