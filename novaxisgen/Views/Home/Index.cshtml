<script>
    document.addEventListener('DOMContentLoaded', () => {
        function formatarUSD(v){ return v.toLocaleString('en-US',{style:'currency',currency:'USD'}); }
        function animarValor(el, alvo, dur=1200){
            let start=null;
            const step=t=>{
                if(!start) start=t;
                const p=Math.min((t-start)/dur,1);
                el.textContent=formatarUSD(alvo*p);
                if(p<1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        }

        // Anima valores
        ['valorInvestido','valorAReceber','valorRecebido'].forEach(id=>{
            const el=document.getElementById(id);
            const val=parseFloat(el.dataset.valor||'0');
            animarValor(el,val);
        });

        // Barra de progresso + percentual
        const barra=document.getElementById('progressoRetorno');
        const txt=document.getElementById('percentualValorTexto');
        const alvo=parseFloat(barra.getAttribute('aria-valuenow')||'0');

        setTimeout(()=>{ barra.style.width=`${alvo}%`; },200);

        let start=null, dur=1200;
        const animPct=t=>{
            if(!start) start=t;
            const p=Math.min((t-start)/dur,1);
            txt.textContent=`${(alvo*p).toFixed(2).replace('.',',')}%`;
            if(p<1) requestAnimationFrame(animPct);
        };
        requestAnimationFrame(animPct);
    });
</script>
