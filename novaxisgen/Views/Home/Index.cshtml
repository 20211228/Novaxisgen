<style>
  
   /* 1) O documento vira o contêiner de scroll */
  html, body {
    min-height: 100vh;
    height: auto !important;
    overflow-y: auto !important;
  }

  /* 2) Remova alturas e overflows dos wrappers do tema que “prendem” o scroll */
  #kt_wrapper,
  #kt_body,
  #kt_content,
  #content,
  #main,
  #wrapper,
  #kt_content_container {
    height: auto !important;
    min-height: unset !important;
    overflow: visible !important;
  }

  /* Se usar Metronic/keen com page-loader que aplica overflow:hidden no body> */
