<script>
document.addEventListener('DOMContentLoaded', function () {
  const swiper = new Swiper('.mySwiper', {
    autoHeight: false,
    slidesPerView: 1,
    spaceBetween: 16,
    navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
    pagination: { el: '.swiper-pagination', clickable: true },
    on: {
      slideChange() {
        // Pausa e descarrega vídeos quando troca o slide
        swiper.el.querySelectorAll('.js-lazy-video').forEach(v => {
          v.pause();
          if (v.dataset.loaded === 'true') {
            v.removeAttribute('src');
            v.load();
            v.dataset.loaded = 'false';
            v.controls = false;
          }
        });
      }
    }
  });

  // Captura os slides originais para reconstrução
  const allSlides = Array.from(swiper.el.querySelectorAll('.swiper-wrapper > .swiper-slide'));
  const slidesByType = {
    picture: allSlides.filter(s => s.dataset.type === 'picture').map(s => s.outerHTML.trim()),
    video:   allSlides.filter(s => s.dataset.type === 'video').map(s => s.outerHTML.trim()),
  };

  const chkPictures = document.getElementById('filter-pictures');
  const chkVideos   = document.getElementById('filter-videos');

  function ensureAtLeastOne(changed) {
    if (!chkPictures.checked && !chkVideos.checked) {
      changed.checked = true; // impede que os dois fiquem desmarcados
    }
  }

  // Lazy load por clique/toque
  function attachLazy(video) {
    const loadAndPlay = () => {
      if (video.dataset.loaded !== 'true') {
        const src = video.dataset.src;
        if (!src) return;
        video.src = src;
        video.load();
        video.dataset.loaded = 'true';
        video.controls = true;
      }
      video.play().catch(() => {});
    };
    video.addEventListener('click', loadAndPlay);
    video.addEventListener('touchstart', loadAndPlay, { passive: true });
  }

  // Reconstrói as lâminas do Swiper com base nos filtros
  function rebuildSlides() {
    const showPictures = chkPictures.checked;
    const showVideos   = chkVideos.checked;

    let htmlSlides = [];
    if (showPictures) htmlSlides = htmlSlides.concat(slidesByType.picture);
    if (showVideos)   htmlSlides = htmlSlides.concat(slidesByType.video);

    swiper.removeAllSlides();

    if (htmlSlides.length) {
      // ✅ Swiper 11 aceita array aqui
      swiper.appendSlide(htmlSlides);
    } else {
      // Mantém um slide neutro para não quebrar navegação
      swiper.appendSlide(`
        <div class="swiper-slide" style="color:#bbb;display:flex;align-items:center;justify-content:center">
          No media to display
        </div>
      `);
    }

    // Reanexa lazy aos vídeos no DOM atual
    swiper.el.querySelectorAll('.js-lazy-video').forEach(attachLazy);

    swiper.update();
    swiper.slideTo(0, 0);
  }

  function onFilterChange(e) {
    ensureAtLeastOne(e.target);
    rebuildSlides();
  }

  // Inicializações
  swiper.el.querySelectorAll('.js-lazy-video').forEach(attachLazy);
  chkPictures.addEventListener('change', onFilterChange);
  chkVideos  .addEventListener('change', onFilterChange);

  // Primeira construção conforme estado padrão (ambos marcados)
  rebuildSlides();
});
</script>
