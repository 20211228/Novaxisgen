@model IEnumerable<Novaxisgen.Models.LaiHangNgay>
@{
}
<body>
    <div class="d-flex flex-column flex-root">
        <div class="bgi-attachment-fixed d-flex flex-column-fluid flex-row page">
            <div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">
                <div class="toolbar py-5 pb-lg-15" id="kt_toolbar">
                    <div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
                        <div class="page-title d-flex flex-column me-3">
                            <h1 class="d-flex text-white fw-bold my-1 fs-3"></h1>
                        </div>
                    </div>
                </div>
                <div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
                    <div class="content flex-row-fluid" id="kt_content">
                        <div class="row gy-5 g-xl-8">

                            <style>
                                [data-bs-theme="light"] .roi-card {
                                    background: #ffffff !important; /* fundo claro */
                                    color: #000 !important;
                                    border: 1px solid #e5e7eb !important;
                                    box-shadow: 0 8px 24px rgba(0,0,0,.08) !important;
                                }

                                    [data-bs-theme="light"] .roi-card h3 {
                                        color: #6d28d9 !important; /* roxo legível */
                                    }

                                    [data-bs-theme="light"] .roi-card .amount {
                                        color: #7c3aed !important; /* valor roxo */
                                    }

                                /* Tabela do relatório no Light (se quiser texto preto também) */
                                [data-bs-theme="light"] .roi-report .table thead {
                                    background-color: #f9fafb !important;
                                    color: #111827 !important;
                                }

                                [data-bs-theme="light"] .roi-report .table td,
                                [data-bs-theme="light"] .roi-report .table th {
                                    color: #000 !important;
                                    background-color: #fff !important;
                                }

                                [data-bs-theme="light"] .roi-report .table tbody tr:hover {
                                    background-color: #f3f4f6 !important;
                                }

                                .roi-card {
                                    background: linear-gradient(135deg, #1e293b, #111827);
                                    color: #e5e7eb;
                                    padding: 2rem;
                                    border-radius: 1rem;
                                    box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
                                    margin-bottom: 2rem;
                                }

                                    .roi-card h3 {
                                        font-weight: 700;
                                        color: #a78bfa;
                                    }

                                    .roi-card .amount {
                                        font-size: 2.5rem;
                                        font-weight: bold;
                                        color: #c084fc;
                                    }

                                .roi-report .table {
                                    background-color: transparent;
                                    color: #e5e7eb;
                                }

                                    .roi-report .table thead {
                                        background-color: #1f2937;
                                        color: #9ca3af;
                                        text-transform: uppercase;
                                    }

                                    .roi-report .table tbody tr:hover {
                                        background-color: #1e293b;
                                    }

                                .roi-report .badge {
                                    font-size: 0.85rem;
                                    padding: 0.35rem 0.75rem;
                                    border-radius: 0.5rem;
                                }

                                .roi-report .external-link {
                                    color: #60a5fa;
                                    margin-left: 0.5rem;
                                }

                                /* Botão de help padrão */
                                .help-btn {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 50%;
                                    display: inline-grid;
                                    place-items: center;
                                    border: 1px solid #2a2a2a;
                                    background: rgba(0,255,255,.08);
                                    color: #00ffff;
                                    transition: background .2s ease;
                                }

                                    .help-btn:hover {
                                        background: rgba(0,255,255,.15);
                                    }

                                .help-btn--sm {
                                    width: 28px;
                                    height: 28px;
                                    font-size: 14px;
                                }
                            </style>

                            @* <div class="col-xl-12">
                                <!-- Saldo de ROI -->
                                <div class="roi-card d-flex justify-content-between align-items-center">
                                    <h3><i class="fas fa-chart-line me-2"></i> Số dư ROI</h3>
                                    <div class="amount">$ 0.00</div>
                                </div>
                            </div> *@

                            <div class="col-lg-12 roi-report">
                                <div class="card card-custom">
                                    <div class="card-header position-relative">
                                        <div class="card-title">
                                            <h3 class="card-label"><i class="fas fa-file-invoice-dollar me-2"></i> Báo cáo ROI</h3>
                                        </div>


                                        <style>
                                            :root {
                                                --hv-z: 999999; /* z-index muito alto para não conflitar */
                                                --hv-cyan: #00ffff;
                                                --hv-cyan-20: rgba(0,255,255,.20);
                                                --hv-border-08: rgba(255,255,255,.08);
                                                --hv-border-12: rgba(255,255,255,.12);
                                            }

                                            /* ===== Raiz da micro-modal (SEM Bootstrap) ===== */
                                            #hv_d8b5a740_root {
                                                display: none;
                                                position: fixed;
                                                inset: 0;
                                                z-index: var(--hv-z);
                                                isolation: isolate;
                                            }

                                                #hv_d8b5a740_root.hv-open {
                                                    display: block;
                                                }

                                                /* Overlay com leve blur/vidro */
                                                #hv_d8b5a740_root .hv-overlay {
                                                    position: fixed;
                                                    inset: 0;
                                                    background: rgba(0,0,0,.70);
                                                    backdrop-filter: blur(3px);
                                                }

                                                /* Caixa do diálogo (player) */
                                                #hv_d8b5a740_root .hv-dialog {
                                                    position: fixed;
                                                    left: 50%;
                                                    top: 50%;
                                                    transform: translate(-50%,-50%);
                                                    width: min(96vw, 1080px);
                                                    max-height: calc(100vh - 2rem);
                                                    display: flex;
                                                    flex-direction: column;
                                                    overflow: hidden;
                                                    background: #0e1116;
                                                    border: 1px solid var(--hv-border-08);
                                                    border-radius: 18px;
                                                    box-shadow: 0 20px 60px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.04) inset;
                                                }

                                                /* Cabeçalho minimal + título centralizado */
                                                #hv_d8b5a740_root .hv-header {
                                                    padding: .9rem 1.2rem;
                                                    border-bottom: 1px solid var(--hv-border-08);
                                                    display: flex;
                                                    align-items: center;
                                                    justify-content: center;
                                                }

                                                #hv_d8b5a740_root .hv-title {
                                                    margin: 0;
                                                    color: #e6f2f2;
                                                    font-size: 1.06rem;
                                                    letter-spacing: .2px;
                                                    text-shadow: 0 0 8px rgba(0,255,255,.18);
                                                }

                                                /* Botão X flutuante (FORA da caixa), menor e no canto da janela */
                                                #hv_d8b5a740_root .hv-close-top {
                                                    position: fixed; /* não fica sobre o vídeo */
                                                    right: 12px;
                                                    top: calc(env(safe-area-inset-top, 0px) + 12px); /* respeita notch em mobile */
                                                    width: 32px;
                                                    height: 32px;
                                                    border-radius: 50%;
                                                    display: grid;
                                                    place-items: center;
                                                    cursor: pointer;
                                                    color: #fff;
                                                    background: rgba(20,24,32,.80);
                                                    box-shadow: 0 0 0 1px var(--hv-border-12), 0 6px 18px rgba(0,0,0,.35);
                                                    backdrop-filter: blur(4px);
                                                    transition: transform .12s ease, box-shadow .15s ease, background .15s ease, color .15s ease;
                                                    z-index: calc(var(--hv-z) + 1);
                                                    user-select: none;
                                                }

                                                    #hv_d8b5a740_root .hv-close-top:hover {
                                                        transform: scale(1.05);
                                                        background: rgba(20,24,32,.92);
                                                        box-shadow: 0 0 0 1px var(--hv-cyan-20), 0 10px 22px rgba(0,255,255,.20);
                                                        color: var(--hv-cyan);
                                                    }

                                                    #hv_d8b5a740_root .hv-close-top svg {
                                                        width: 16px;
                                                        height: 16px;
                                                        display: block;
                                                    }

                                                /* Corpo/player */
                                                #hv_d8b5a740_root .hv-body {
                                                    padding: 0;
                                                    background: #000;
                                                }

                                                #hv_d8b5a740_root .player-aspect {
                                                    aspect-ratio: 16/9;
                                                    width: 100%;
                                                }

                                            @@media (min-width: 992px) {
                                                #hv_d8b5a740_root .player-aspect {
                                                    aspect-ratio: auto;
                                                    height: 62vh;
                                                }
                                            }

                                            #hv_d8b5a740_root video {
                                                width: 100%;
                                                height: 100%;
                                                display: block;
                                                object-fit: contain;
                                                background: #000;
                                                opacity: 1 !important;
                                                filter: none !important;
                                                pointer-events: auto !important;
                                            }

                                            /* Rodapé */
                                            #hv_d8b5a740_root .hv-footer {
                                                border-top: 1px solid var(--hv-border-08);
                                                display: flex;
                                                justify-content: flex-end;
                                                gap: .6rem;
                                                padding: .9rem 1.2rem;
                                            }

                                            #hv_d8b5a740_root .hv-btn {
                                                appearance: none;
                                                border: 0;
                                                cursor: pointer;
                                                border-radius: 12px;
                                                padding: .55rem 1rem;
                                                font-weight: 600;
                                                letter-spacing: .2px;
                                                color: #0c1222;
                                                background: linear-gradient(135deg, #a7f3ff, #44e0ff);
                                                box-shadow: 0 8px 24px rgba(0,255,255,.18), 0 0 0 1px rgba(255,255,255,.06) inset;
                                                transition: transform .12s ease, box-shadow .2s ease, filter .15s ease;
                                            }

                                                #hv_d8b5a740_root .hv-btn:hover {
                                                    transform: translateY(-1px);
                                                    box-shadow: 0 12px 28px rgba(0,255,255,.24), 0 0 0 1px rgba(255,255,255,.08) inset;
                                                    filter: saturate(1.05);
                                                }

                                            /* Evita scroll “vazando” na janela ao abrir */
                                            html.hv-lock, body.hv-lock {
                                                overflow: hidden !important;
                                            }
                                        </style>


                                        <button id="hv_d8b5a740_open" type="button" class="help-btn help-btn--sm position-absolute top-0 end-0 m-2">?</button>




                                        <script>
                                            (function () {
                                                const root = document.getElementById("hv_d8b5a740_root");
                                                const video = document.getElementById("hv_d8b5a740_video");
                                                const openBt = document.getElementById("hv_d8b5a740_open");
                                                if (!root || !openBt || !video) return;

                                                // Portal para <body> (evita herdar opacity/transform dos pais)
                                                if (root.parentElement !== document.body) document.body.appendChild(root);

                                                const overlay = root.querySelector('.hv-overlay');
                                                const dialog = root.querySelector('.hv-dialog');
                                                const closeTop = root.querySelector('.hv-close-top');
                                                const closeNice = root.querySelector('.js-hv-close');

                                                const lockScroll = () => { document.documentElement.classList.add('hv-lock'); document.body.classList.add('hv-lock'); };
                                                const freeScroll = () => { document.documentElement.classList.remove('hv-lock'); document.body.classList.remove('hv-lock'); };

                                                function show() {
                                                    root.classList.add('hv-open');
                                                    root.setAttribute('aria-hidden', 'false');
                                                    lockScroll();

                                                    // Garante vídeo visível e tenta iniciar
                                                    video.style.opacity = '1';
                                                    video.style.filter = 'none';
                                                    try { video.play().catch(() => { }); } catch { }

                                                    // Foco de acessibilidade na caixa
                                                    setTimeout(() => dialog?.focus?.(), 0);
                                                }

                                                function hide() {
                                                    try { video.pause(); } catch { }
                                                    root.classList.remove('hv-open');
                                                    root.setAttribute('aria-hidden', 'true');
                                                    freeScroll();
                                                }

                                                // Abertura
                                                openBt.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); show(); });

                                                // Fechamentos
                                                overlay.addEventListener('click', hide);
                                                closeTop.addEventListener('click', hide);
                                                closeNice.addEventListener('click', hide);
                                                document.addEventListener('keydown', e => { if (root.classList.contains('hv-open') && e.key === 'Escape') hide(); });

                                                // Evita que cliques dentro do diálogo fechem a modal
                                                dialog.addEventListener('click', e => e.stopPropagation());
                                            })();
                                        </script>
                                    </div>

                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-bordered">
                                                <thead>
                                                    <tr>
                                                        
                                                        <th>Ngày</th>
                                                        <th>Gói đầu tư</th>
                                                        <th>Ngày bắt đầu</th>
                                                        <th>Số tiền đầu tư(USD)</th>
                                                        <th>Số tiền lãi</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                                                    @foreach(var d in Model)
                                                    {
                                                        <tr>
                                                        <td>@d.NgayTao</td>
                                                        <td>@d.DauTu.GoiDauTu.TenGoi</td>
                                                        <td>@d.DauTu.NgayBatDau</td>
                                                        <td>@d.DauTu.GoiDauTu.SoTien</td>
                                                        <td>@d.SoTienLai.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>

                                        <!-- Paginação -->
                                        <div class="mt-4 d-flex justify-content-center">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="footer py-4 d-flex flex-lg-column" id="kt_footer">
                    <div class="container-xxl d-flex flex-column flex-md-row align-items-center justify-content-between">
                        <div class="text-gray-900 order-2 order-md-1">
                            <span class="text-muted fw-semibold me-1">2025©</span>
                            <a href="https://genesis-tech.net" target="_blank" class="text-gray-800 text-hover-primary">Genesis</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="hv_d8b5a740_root" aria-hidden="true" role="dialog" aria-modal="true" data-hv="hv_d8b5a740">
        <div class="hv-overlay"></div>


        <button type="button" class="hv-close-top" aria-label="Đóng">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
        </button>

        <div class="hv-dialog" role="document" tabindex="-1">
            <div class="hv-header">
                <h5 class="hv-title">Hướng dẫn</h5>
            </div>

            <div class="hv-body">
                <div class="player-aspect">
                    <video id="hv_d8b5a740_video" controls="" playsinline="" preload="metadata" poster="https://cdnexchange-gzgmdwebe6dee9hs.z02.azurefd.net/personal-documents/thumbs/t06-vn.png" src="https://cdnexchange-gzgmdwebe6dee9hs.z02.azurefd.net/personal-documents/t06-vn.mp4"></video>
                </div>
            </div>

            <div class="hv-footer">
                <button type="button" class="hv-btn js-hv-close">Đóng</button>
            </div>
        </div>
    </div>
    <div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
        <i class="ki-duotone ki-arrow-up">
            ⬆️
        </i>
    </div>



    <svg id="SvgjsSvg1001" width="2" height="0" xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svgjs="http://svgjs.dev" style="overflow: hidden; top: -100%; left: -100%; position: absolute; opacity: 0;"><defs id="SvgjsDefs1002"></defs><polyline id="SvgjsPolyline1003" points="0,0"></polyline><path id="SvgjsPath1004" d="M0 0 "></path></svg>
</body>