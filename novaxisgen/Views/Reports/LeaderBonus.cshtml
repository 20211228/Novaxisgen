

@{
}
<body>
    <div class="d-flex flex-column flex-root">
        <div class="bgi-attachment-fixed d-flex flex-column-fluid flex-row page">
            <div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">                <div class="toolbar py-5 pb-lg-15" id="kt_toolbar">
                    <div id="kt_toolbar_container" class="container-xxl d-flex flex-stack flex-wrap">
                        <div class="page-title d-flex flex-column me-3">
                            <h1 class="d-flex text-white fw-bold my-1 fs-3"></h1>
                        </div>
                    </div>
                </div>
                <div id="kt_content_container" class="d-flex flex-column-fluid align-items-start container-xxl">
                    <div class="content flex-row-fluid" id="kt_content">
                        <div class="row gy-5 g-xl-8">


                            <style>
                                /* Header translúcido */
                                .token-report .table thead {
                                    background: rgba(255,255,255,.65) !important;
                                }

                                [data-bs-theme="dark"] .token-report .table thead {
                                    background: rgba(2,6,23,.55) !important;
                                }

                                /* Linhas em hover */
                                .token-report .table tbody tr:hover {
                                    background: rgba(0,0,0,.04) !important;
                                }

                                [data-bs-theme="dark"] .token-report .table tbody tr:hover {
                                    background: rgba(255,255,255,.04) !important;
                                }

                                /* Card */
                                [data-bs-theme="light"] .token-card {
                                    background: #ffffff !important;
                                    color: #000 !important;
                                    border: 1px solid #e5e7eb !important;
                                    box-shadow: 0 8px 24px rgba(0,0,0,.08) !important;
                                }

                                .token-card {
                                    background: linear-gradient(135deg, #1e293b, #111827);
                                    color: #e5e7eb;
                                    padding: 2rem;
                                    border-radius: 1rem;
                                    box-shadow: 0 0 20px rgba(0,0,0,0.3);
                                    margin-bottom: 2rem;
                                }

                                    .token-card h3 {
                                        font-weight: 700;
                                        color: #60a5fa;
                                    }

                                    /* Valor total à direita do card */
                                    .token-card .amount {
                                        font-size: 2rem;
                                        font-weight: 800;
                                        color: #10b981; /* verde */
                                        white-space: nowrap;
                                    }

                                [data-bs-theme="light"] .token-card .amount {
                                    color: #059669;
                                }

                                .token-report .table {
                                    background-color: transparent;
                                    color: #e5e7eb;
                                }

                                    .token-report .table thead {
                                        background-color: #1f2937;
                                        color: #9ca3af;
                                        text-transform: uppercase;
                                    }

                                    .token-report .table tbody tr:hover {
                                        background-color: #1e293b;
                                    }

                                .token-report .badge {
                                    font-size: 0.85rem;
                                    padding: 0.35rem 0.75rem;
                                    border-radius: 0.5rem;
                                }

                                .token-report .external-link {
                                    color: #60a5fa;
                                    margin-left: 0.5rem;
                                    text-decoration: none;
                                }
                            </style>

                            <div class="col-xl-12">
                                <!-- Cabeçalho -->
                                <div class="token-card d-flex justify-content-between align-items-center">
                                    <h3 class="mb-0">
                                        <i class="fas fa-coins me-2"></i> Hoa hồng lãnh đạo
                                    </h3>

                                    <div class="amount">
                                        0.00000
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12 token-report">
                                <div class="card card-custom">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>Ngày</th>
                                                        <th>Thành viên</th>
                                                        <th>Cấp VIP</th>
                                                        <th>Nhánh yếu</th>
                                                        <th>Hoa hồng(%)</th>
                                                        <th>Tiền hoa hồng</th>
                                                        <th>Điều kiện đã đạt</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Paginação -->
                                        <div class="mt-4 d-flex justify-content-center">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="footer py-4 d-flex flex-lg-column" id="kt_footer">
                    <div class="container-xxl d-flex flex-column flex-md-row align-items-center justify-content-between">
                        <div class="text-gray-900 order-2 order-md-1">
                            <span class="text-muted fw-semibold me-1">2025©</span>
                            <a href="https://genesis-tech.net" target="_blank" class="text-gray-800 text-hover-primary">Genesis</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
        <i class="ki-duotone ki-arrow-up">
            ⬆️
        </i>
    </div>



