	<script>
		(function () {
			const canvas = document.getElementById('space');
			if (!canvas) return;
			const ctx = canvas.getContext('2d', { alpha: true });

			// ===== Configs de performance =====
			const DPR = Math.min(window.devicePixelRatio || 1, 1.5); // cap retina
			const MAX_DIST = 120;
			const MAX_DIST2 = MAX_DIST * MAX_DIST;
			const CELL = MAX_DIST; // tamanho da célula da grade espacial

			let W = 0, H = 0;
			let stars = [], comets = [], nodes = [];
			let running = true;
			let resizeRaf = 0;

			// Debounce de resize + DPR-aware
			function applySize() {
				const w = window.innerWidth;
				const h = window.innerHeight;
				if (w === W && h === H) return;

				W = w; H = h;
				canvas.width = Math.max(1, Math.floor(W * DPR));
				canvas.height = Math.max(1, Math.floor(H * DPR));
				// desenhar em coordenadas lógicas (sem precisar multiplicar tudo por DPR)
				ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
			}

			function onResize() {
				if (resizeRaf) cancelAnimationFrame(resizeRaf);
				resizeRaf = requestAnimationFrame(() => {
					applySize();
					// Rebalanceia quantidades mantendo o "look"
					seedPopulations();
				});
			}

			window.addEventListener('resize', onResize, { passive: true });
			applySize();

			// ===== Classes =====
			function Star() {
				this.x = Math.random() * W;
				this.y = Math.random() * H;
				this.r = Math.random() * 1.5;
				this.a = Math.random();
				this.da = (Math.random() * 0.02) * (Math.random() < 0.5 ? 1 : -1);
			}
			Star.prototype.draw = function () {
				let a = this.a + this.da;
				if (a <= 0.1 || a >= 1) this.da = -this.da;
				this.a += this.da;
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.r, 0, 6.283185307179586);
				ctx.fillStyle = 'rgba(0,255,255,' + this.a + ')';
				ctx.fill();
			};

			function Comet() {
				this.reset();
				this.len = Math.random() * 80 + 40;
			}
			Comet.prototype.reset = function () {
				this.x = Math.random() * W;
				this.y = Math.random() * (H * 0.5);
				this.dx = Math.random() * 1 + 0.5;
				this.dy = Math.random() * 0.5 + 0.2;
			};
			Comet.prototype.draw = function () {
				ctx.beginPath();
				// criar gradiente é relativamente barato aqui (são pouquíssimos cometas)
				const grad = ctx.createLinearGradient(this.x, this.y, this.x - this.len, this.y - this.len / 2);
				grad.addColorStop(0, 'rgba(0,255,255,0.8)');
				grad.addColorStop(1, 'rgba(0,255,255,0)');
				ctx.strokeStyle = grad;
				ctx.lineWidth = 2;
				ctx.moveTo(this.x, this.y);
				ctx.lineTo(this.x - this.len, this.y - this.len / 2);
				ctx.stroke();

				this.x += this.dx; this.y += this.dy;
				if (this.x > W + 50 || this.y > H + 50) {
					this.x = -50; this.y = Math.random() * (H * 0.5);
				}
			};

			function Node() {
				this.x = Math.random() * W;
				this.y = Math.random() * H;
				this.vx = Math.random() * 0.6 - 0.3;
				this.vy = Math.random() * 0.6 - 0.3;
			}
			Node.prototype.step = function () {
				this.x += this.vx; this.y += this.vy;
				if (this.x < 0 || this.x > W) this.vx = -this.vx;
				if (this.y < 0 || this.y > H) this.vy = -this.vy;
			};
			Node.prototype.draw = function () {
				ctx.beginPath();
				ctx.arc(this.x, this.y, 2, 0, 6.283185307179586);
				ctx.fillStyle = 'rgba(0,255,255,0.6)';
				ctx.fill();
			};

			// ===== Spatial Hash (grade) para conexões O(n) =====
			function buildGrid(nodes) {
				const grid = new Map(); // chave "cx,cy" -> array de índices
				for (let i = 0; i < nodes.length; i++) {
					const n = nodes[i];
					const cx = (n.x / CELL) | 0;
					const cy = (n.y / CELL) | 0;
					const key = cx + ',' + cy;
					const bucket = grid.get(key);
					if (bucket) bucket.push(i); else grid.set(key, [i]);
				}
				return grid;
			}
			function* neighborBuckets(cx, cy) {
				for (let iy = cy - 1; iy <= cy + 1; iy++) {
					for (let ix = cx - 1; ix <= cx + 1; ix++) {
						yield ix + ',' + iy;
					}
				}
			}

			// ===== População proporcional à área (mesmo look, melhor custo) =====
			function seedPopulations() {
				const area = (W * H);
				// referentes às quantidades originais para ~1920x1080
				const baseArea = 1920 * 1080;

				const starsTarget = clamp(Math.round(160 * (area / baseArea)), 80, 250);
				const nodesTarget = clamp(Math.round(40 * (area / baseArea)), 24, 70);
				const cometsTarget = clamp(Math.round(5 * Math.sqrt(area / baseArea)), 3, 7);

				// reusa quando possível para evitar GC
				resizeArray(stars, starsTarget, () => new Star());
				resizeArray(nodes, nodesTarget, () => new Node());
				resizeArray(comets, cometsTarget, () => new Comet());
			}

			function resizeArray(arr, target, factory) {
				if (arr.length > target) {
					arr.length = target;
				} else if (arr.length < target) {
					const need = target - arr.length;
					for (let i = 0; i < need; i++) arr.push(factory());
				}
			}

			function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }

			// ===== Frame loop =====
			function frame() {
				if (!running) return;

				// fundo/nébula (limpa e mantém o "fade")
				ctx.clearRect(0, 0, W, H);
				ctx.fillStyle = 'rgba(0,0,0,0.4)';
				ctx.fillRect(0, 0, W, H);

				// estrelas
				for (let i = 0; i < stars.length; i++) stars[i].draw();

				// cometas
				for (let i = 0; i < comets.length; i++) comets[i].draw();

				// nós + conexões (com grade espacial)
				for (let i = 0; i < nodes.length; i++) nodes[i].step();
				const grid = buildGrid(nodes);

				ctx.lineWidth = 1;
				for (let i = 0; i < nodes.length; i++) {
					const a = nodes[i];
					const cx = (a.x / CELL) | 0;
					const cy = (a.y / CELL) | 0;

					for (const key of neighborBuckets(cx, cy)) {
						const bucket = grid.get(key);
						if (!bucket) continue;
						for (let k = 0; k < bucket.length; k++) {
							const j = bucket[k];
							if (j <= i) continue; // evita duplicar par
							const b = nodes[j];
							const dx = a.x - b.x;
							const dy = a.y - b.y;
							const d2 = dx * dx + dy * dy;
							if (d2 < MAX_DIST2) {
								// alpha proporcional à proximidade
								// (1 - d/Max) * 0.25  ≈  (1 - sqrt(d2)/MAX_DIST) * 0.25
								const alpha = (1 - Math.sqrt(d2) / MAX_DIST) * 0.25;
								ctx.strokeStyle = 'rgba(0,255,255,' + alpha + ')';
								ctx.beginPath();
								ctx.moveTo(a.x, a.y);
								ctx.lineTo(b.x, b.y);
								ctx.stroke();
							}
						}
					}
					nodes[i].draw();
				}

				requestAnimationFrame(frame);
			}

			// ===== Inicialização suave (não travar first paint) =====
			function init() {
				seedPopulations();
				// start no próximo frame para priorizar o paint da UI
				requestAnimationFrame(frame);
			}

			// Usa requestIdleCallback quando existir; senão, fallback mínimo
			const idle = window.requestIdleCallback || function (cb) { return setTimeout(() => cb({ timeRemaining: () => 50 }), 1); };
			idle(() => init());

			// Pausar quando a aba estiver oculta (economiza CPU)
			document.addEventListener('visibilitychange', () => {
				running = !document.hidden;
				if (running) requestAnimationFrame(frame);
			}, { passive: true });

		})();
	</script>



