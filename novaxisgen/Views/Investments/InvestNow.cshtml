@@media (max-width: 767.98px) {

  /* Garante que a página nunca passe de 100vw */
  .page, #kt_wrapper, #kt_content {
    width: 100vw;
    max-width: 100vw;
    overflow-x: hidden;
  }

  /* Containers: não deixar ultrapassar a viewport */
  .container, .container-fluid, .content, .content-wrapper {
    max-width: 100% !important;
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  /* Card principal (ex.: investimento/faturas) ocupa 100% e não estoura */
  .card,
  .card > .card-body,
  .card > .card-header,
  .card > .card-footer {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }

  /* Evita que sombras/raios cortem conteúdo no mobile */
  .card {
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
  }

  /* Imagens/figuras dentro do card: fluidas */
  .card img,
  .card svg,
  .card canvas,
  .card video,
  .card .figure,
  .card .ratio,
  .card .embed-responsive,
  .card .card-img,
  .card .card-img-top,
  .card .card-img-bottom {
    max-width: 100% !important;
    width: 100% !important;
    height: auto !important;
  }

  /* Títulos e textos grandes não devem quebrar layout */
  .card h1, .card h2, .card h3, .card h4,
  .card .display-1, .card .display-2, .card .display-3, .card .display-4 {
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  /* Se existir algum wrapper do seu card (ex.: .invest-card / .faturas-card),
     também força 100% da largura */
  .invest-card, .faturas-card, .investment-card, .billing-card {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Neutraliza larguras fixas comuns e inline (evita 600px/700px etc.) */
  [style*="width:"],
  .w-600, .w-700, .w-800, .w-900 {
    width: auto !important;
    max-width: 100% !important;
  }

  /* Linha/colunas: evita overflow por margem negativa */
  .row {
    margin-left: 0;
    margin-right: 0;
  }
  .col, [class*="col-"] {
    padding-left: 10px;
    padding-right: 10px;
  }

  /* Grupos de botões não empurrarem para fora */
  .btn-toolbar, .btn-group {
    flex-wrap: wrap;
    gap: 6px;
  }
  .btn {
    min-height: 42px;
  }
  .btn-icon {
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
  }

  /* Se houver algum scale aplicado no card, remove no mobile */
  .card[style*="transform"],
  [style*="transform: scale"] {
    transform: none !important;
  }

  /* Table/embeds dentro do card não estourarem */
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
}

