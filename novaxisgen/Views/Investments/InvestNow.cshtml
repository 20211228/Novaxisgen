<script>
    document.querySelectorAll('.radio-pacote').forEach(radio => {
        radio.addEventListener('change', function () {
            document.getElementById('amountInput').value = this.value;
        });
    });

    const amountInput = document.getElementById('amountInput');
    amountInput.addEventListener('input', function () {
    const customValue = parseFloat(this.value);
    let matched = false;

    document.querySelectorAll('.radio-pacote').forEach(radio => {
        if (parseFloat(radio.value) === customValue) {
            if (!radio.checked) radio.checked = true;
            matched = true;
        }
    });

    if (!matched) {
        const customRadio = document.getElementById('pacoteCustom');
        if (!customRadio.checked) customRadio.checked = true;
    }

    updateSelectionHighlight();
});

</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const radios = document.querySelectorAll('.radio-pacote');

    function updateSelectionHighlight() {
        document.querySelectorAll('.form-check').forEach(el => el.classList.remove('selected'));
        document.querySelectorAll('.radio-pacote:checked').forEach(input => {
            input.closest('.form-check').classList.add('selected');
        });
    }

    radios.forEach(radio => {
        radio.addEventListener('change', updateSelectionHighlight);
    });

    // inicializa seleção visual ao carregar
    updateSelectionHighlight();
});
</script>


