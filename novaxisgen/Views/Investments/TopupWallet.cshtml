                                            }

                                            /* ===== Raiz da micro-modal (SEM Bootstrap) ===== */
                                            #hv_7217c098_root {
                                                display: none;
                                                position: fixed;
                                                inset: 0;
                                                z-index: var(--hv-z);
                                                isolation: isolate;
                                            }

                                                #hv_7217c098_root.hv-open {
