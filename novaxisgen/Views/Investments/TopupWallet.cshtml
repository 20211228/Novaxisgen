                                                }

                                                /* Caixa do diálogo (player) */
                                                #hv_7217c098_root .hv-dialog {
                                                    position: fixed;
                                                    left: 50%;
                                                    top: 50%;
                                                    transform: translate(-50%,-50%);
                                                    width: min(96vw, 1080px);
                                                    max-height: calc(100vh - 2rem);
                                                    display: flex;
                                                    flex-direction: column;
                                                    overflow: hidden;
                                                    background: #0e1116;
                                                    border: 1px solid var(--hv-border-08);
