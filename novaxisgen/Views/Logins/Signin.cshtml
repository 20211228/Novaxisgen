<body>

    <canvas id="space" width="920" height="744"></canvas>

    <div class="container">
        <div class="login-section">
            <div class="login-title">
                <img src="https://genesis-tech.net/assets/media/logos/demo2.png" alt="Logo" style="max-width: 300px; margin-bottom: 20px; display: block; margin-left: auto; margin-right: auto;">
                <h2>Access Protocol</h2>
                <p>Authentication Required</p>
            </div>
            <form method="POST" action="@Url.Action("Index","Home")">
                <input type="hidden" name="_token" value="YH622JDNuKJdrasxqGnsq8LqiXgDzGyowJN19uyR" autocomplete="off">        <div class="form-group">
                    <label><i class="fas fa-user-astronaut"></i> USERNAME</label>
                    <input type="text" name="login" required="" placeholder="Username">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-lock"></i> PASSWORD</label>
                    <input type="password" name="password" required="" placeholder="Password">
                </div>
                <button type="submit" class="login-btn">Sign In</button>
            </form>
            <a href="https://genesis-tech.net/forgot-password" class="forgot-password">
                Forget Password
            </a>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('space');
        const ctx = canvas.getContext('2d');
        let stars = [],
            comets = [];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        function Star() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.r = Math.random() * 1.5;
            this.a = Math.random();
            this.da = Math.random() * 0.02;
            this.draw = () => {
                this.a += this.da;
                if (this.a <= 0.1 || this.a >= 1) this.da *= -1;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255,255,255,${this.a})`;
                ctx.fill();
            };
        }

        function Comet() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height / 2;
            this.dx = Math.random() * 1 + 0.5;
            this.dy = Math.random() * 0.5 + 0.2;
            this.length = 10 + Math.random() * 10;
            this.draw = () => {
                for (let i = 0; i < this.length; i++) {
                    ctx.beginPath();
                    ctx.arc(this.x - i * this.dx, this.y - i * this.dy, 1.5, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255,255,255,${1 - i / this.length})`;
                    ctx.fill();
                }
                this.x += this.dx;
                this.y += this.dy;
                if (this.x > canvas.width || this.y > canvas.height) {
                    this.x = -20;
                    this.y = Math.random() * canvas.height / 2;
                }
            };
        }

        function init() {
            stars = Array.from({
                length: 200
            }, () => new Star());
            comets = Array.from({
                length: 5
            }, () => new Comet());
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(s => s.draw());
            comets.forEach(c => c.draw());
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', () => {
            resize();
            init();
        });

        resize();
        init();
        animate();
    </script>



