
@{
    Layout = null;
}
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Genesis</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&amp;display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Orbitron', sans-serif;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      background: #000;
    }

    canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      display: flex;
      height: 100%;
      flex-direction: row;
    }

    .login-section {
      width: 40%;
      max-width: 450px;
      min-width: 300px;
      background: rgba(0, 255, 255, 0.05);
      border-left: 4px solid #00e0ff33;
      border-radius: 0 20px 20px 0;
      padding: 20px 30px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-shadow: 10px 0 40px rgba(0, 255, 255, 0.1);
      animation: floatPanel 8s ease-in-out infinite;
    }

    @@keyframes floatPanel {

      0%,
      100% {
        transform: translateY(0px);
      }

      50% {
        transform: translateY(-4px);
      }
    }

    .login-title h2 {
      color: #00e0ff;
      margin: 0 0 10px;
      text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
    }

    .login-title p {
      margin: 0 0 30px;
      color: #aee0ff;
      font-size: 14px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      color: #00e0ff;
      font-size: 12px;
      display: block;
      margin-bottom: 5px;
      text-shadow: 0 0 5px #00e0ff77;
      letter-spacing: 1px;
    }

    .form-group i {
      margin-right: 6px;
      opacity: 0.8;
    }

    .form-group input {
      width: 100%;
      padding: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(0, 255, 255, 0.15);
      color: #fff;
      border-radius: 6px;
      box-shadow: inset 0 0 10px rgba(0, 255, 255, 0.05);
    }

    .login-btn {
      background: linear-gradient(90deg, #00fff7, #0072ff);
      color: #000;
      font-weight: bold;
      border: none;
      border-radius: 8px;
      padding: 14px;
      margin-top: 20px;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
      animation: glowPulse 2s infinite ease-in-out;
    }

    @@keyframes glowPulse {

      0%,
      100% {
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
      }

      50% {
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.8);
      }
    }

    .forgot-password {
      text-align: center;
      font-size: 12px;
      margin-top: 15px;
      color: #aee0ff;
      text-decoration: none;
    }

    .forgot-password:hover {
      color: #fff;
      text-decoration: underline;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
      .container {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .login-section {
        width: 100%;
        border-left: none;
        border-radius: 14px;
        box-shadow: 0 0 30px rgba(0, 255, 255, 0.15);
        padding: 40px 20px;
        animation: none;
      }

      .login-title h2 {
        text-align: center;
        font-size: 22px;
      }

      .login-title p {
        text-align: center;
        font-size: 13px;
      }

      .login-btn {
        font-size: 14px;
        padding: 12px;
      }
    }
  </style>
