    <script>
        (function () {
            const canvas = document.getElementById('space');
            if (!canvas) return;

            // Contexto com alpha para sobrepor o fundo preto sem “forçar” opacidade
            const ctx = canvas.getContext('2d', { alpha: true });

            // Para nitidez em telas retina sem “acelerar” a animação
            const DPR = Math.min(window.devicePixelRatio || 1, 2);

            let stars = [];
            let comets = [];

            function resize() {
                const w = window.innerWidth;
                const h = window.innerHeight;
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';
                canvas.width = Math.floor(w * DPR);
                canvas.height = Math.floor(h * DPR);
                ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            }

            function Star() {
                this.x = Math.random() * window.innerWidth;
                this.y = Math.random() * window.innerHeight;
                this.r = Math.random() * 1.5 + 0.2;
                this.a = Math.random() * 0.9 + 0.1;  // evita 0
                this.da = (Math.random() * 0.02 + 0.005) * (Math.random() < 0.5 ? 1 : -1);
                this.draw = () => {
                    // brilho “piscando” suave e estável
                    this.a += this.da;
                    if (this.a <= 0.1 || this.a >= 1) this.da *= -1;

                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255,255,255,${this.a})`;
                    ctx.fill();
                };
            }

            function Comet() {
                this.reset = () => {
                    this.x = -20;
                    this.y = Math.random() * window.innerHeight * 0.5;
                    this.dx = Math.random() * 1 + 0.5;
                    this.dy = Math.random() * 0.5 + 0.2;
                    this.length = 10 + Math.random() * 10;
                };
                this.reset();
                this.draw = () => {
                    for (let i = 0; i < this.length; i++) {
                        ctx.beginPath();
                        ctx.arc(this.x - i * this.dx, this.y - i * this.dy, 1.5, 0, Math.PI * 2);
                        ctx.fillStyle = `rgba(255,255,255,${1 - i / this.length})`;
                        ctx.fill();
                    }
                    this.x += this.dx;
                    this.y += this.dy;
                    if (this.x > window.innerWidth || this.y > window.innerHeight) {
                        this.reset();
                    }
                };
            }

            function init() {
                stars = Array.from({ length: 200 }, () => new Star());
                comets = Array.from({ length: 5 }, () => new Comet());
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                stars.forEach(s => s.draw());
                comets.forEach(c => c.draw());
                requestAnimationFrame(animate);
            }

            window.addEventListener('resize', () => {
                resize();
                // manter quantidade e reposicionar apenas se desejar um “redraw” completo
                // init(); // opcional: reembaralhar estrelas/cometas ao redimensionar
            });

            resize();
            init();
            animate();
        })();
    </script>




