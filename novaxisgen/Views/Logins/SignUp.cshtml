    <!--begin::Language select behavior (robusto + largura 100% no Select2)-->
    <script>
        (function () {
            function toAbsolute(url) {
                if (!url) return '';
                if (/^https?:\/\//i.test(url)) return url;        // já absoluta
                if (url.charAt(0) !== '/') url = '/' + url;       // garante leading slash
                return window.location.origin + url;
            }
            function go(url) {
                var f = document.getElementById('langSwitchForm');
                if (!f) { window.location.assign(url); return; }
                f.setAttribute('action', url);
                f.submit();
            }
            function onChangeLang(value, urlRaw) {
                var url = toAbsolute(urlRaw);
                if (url) go(url);
            }
            document.addEventListener('DOMContentLoaded', function () {
                var sel = document.getElementById('langSelect');
                if (!sel) return;

                // Inicializa Select2 com largura total se disponível (Metronic)
                if (window.jQuery && jQuery.fn && jQuery.fn.select2) {
                    jQuery(sel).select2({ width: '100%' });
                    jQuery(sel).on('select2:select', function () {
                        var opt = sel.options[sel.selectedIndex];
                        onChangeLang(sel.value, opt && opt.getAttribute('data-url'));
                    });
                }

                // Fallback para evento nativo
                sel.addEventListener('change', function () {
                    var opt = sel.options[sel.selectedIndex];
                    onChangeLang(sel.value, opt && opt.getAttribute('data-url'));
                });
            });
        })();
    </script>
    <script>
        (function () {
            function formatLang(opt) {
                if (!opt.id) { return opt.text; }
                var flag = opt.element.getAttribute('data-flag');
                if (flag) {
                    return $(
                        '<span class="d-flex align-items-center">' +
                        '<img src="' + flag + '" class="me-2 rounded-1" style="width:16px;height:16px;" />' +
                        '<span>' + opt.text + '</span>' +
                        '</span>'
                    );
                }
                return opt.text;
            };

            document.addEventListener('DOMContentLoaded', function () {
                var sel = $('#langSelect');
                if (sel.length) {
                    sel.select2({
                        width: '100%',
                        templateResult: formatLang,
                        templateSelection: formatLang,
                        escapeMarkup: function (m) { return m; } // permite HTML no resultado
                    });

                    sel.on('select2:select', function (e) {
                        var opt = sel[0].options[sel[0].selectedIndex];
                        var url = opt.getAttribute('data-url');
                        if (url) { window.location.href = url; }
                    });
                }
            });
        })();
    </script>

    <!--end::Language select behavior-->
