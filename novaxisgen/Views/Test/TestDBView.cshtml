@{
    ViewData["Title"] = "Test Hoa Hồng Trực Tiếp";
    Layout = null;
}

<h2>@ViewData["Title"]</h2>

<p>@ViewBag.Message</p>

<form method="get">
    <label>User ID (người đầu tư):</label>
    <input type="number" name="userId" required />
    <br />
    <label>Số tiền đầu tư:</label>
    <input type="number" step="0.01" name="soTien" required />
    <br />
    <button type="submit">Tính hoa hồng</button>
</form>
