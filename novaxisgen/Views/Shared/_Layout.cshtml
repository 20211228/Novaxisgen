    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function getCurrentTheme() {
                // Prefer attribute on <html>; fallback to localStorage
                var attr = (document.documentElement && document.documentElement.getAttribute('data-bs-theme')) || '';
                var stored = localStorage.getItem('data-bs-theme') || '';
                var theme = (attr || stored || 'dark').toLowerCase();
                return (theme === 'light' || theme === 'dark') ? theme : 'dark';
            }
            function applyLabel() {
                try {
                    var theme = getCurrentTheme();
                    var label = (theme === 'light') ? 'Light' : 'Dark';
                    var iconClass = (theme === 'light') ? 'bi-brightness-high' : 'bi-moon';
                    var btns = [document.getElementById('themeToggleFixed'), document.getElementById('themeToggleMobile')].filter(Boolean);
                    btns.forEach(function (btn) {
                        var span = btn.querySelector('.theme-label');
                        if (span) span.textContent = label;
                        var i = btn.querySelector('i');
                        if (i) i.className = 'bi ' + iconClass;
                    });
                } catch (e) { }
            }

            // Observe changes to data-bs-theme attribute to keep labels in sync
            if (window.MutationObserver) {
                try {
                    var obs = new MutationObserver(function (mutations) {
                        for (var m of mutations) {
                            if (m.type === 'attributes' && m.attributeName === 'data-bs-theme') {
                                applyLabel();
                            }
                        }
                    });
                    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
                } catch (e) { }
            }

            // Wrap __applyTheme if it exists (so label updates when your existing code runs)
            if (typeof window.__applyTheme === 'function') {
                var _origApply = window.__applyTheme;
                window.__applyTheme = function (theme) {
                    _origApply(theme);
                    applyLabel();
                };
            }

            // Also attach click listener to desktop button to update label after toggling
            var fixedBtn = document.getElementById('themeToggleFixed');
            if (fixedBtn) {
                fixedBtn.addEventListener('click', function () {
                    setTimeout(applyLabel, 0);
                }, { capture: true });
            }

            // Initial sync
            applyLabel();

            // Fallback: listen to storage changes as an extra sync path
            window.addEventListener('storage', function (e) {
                if (e.key && e.key.toLowerCase() === 'data-bs-theme') {
                    applyLabel();
                }
            });
        });
