<style>
	/* Documento volta a ser o container de scroll */
	html, body {
		min-height: 100vh;
		height: auto !important;
		overflow-y: auto !important;
		margin: 0;
		padding: 0;
		width: 100%;
		overflow-x: hidden;
	}

	/* Destrava wrappers do tema que prendem o scroll */
	#kt_wrapper,
	#kt_body,
	#kt_content,
	#content,
	#main,
	#wrapper,
	#kt_content_container {
		height: auto !important;
		min-height: unset !important;
		overflow: visible !important;
	}

	/* Evita que containers Bootstrap criem áreas roláveis internas */
	.container,
	.container-fluid,
	.container-xxl {
		overflow: visible !important;
	}

	/* Tipografia global futurista */
	* {
		box-sizing: border-box;
		font-family: 'Yu Gothic', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	}
</style>

<style>
	/* === HEADER COMPACTO === */
	#kt_header { min-height: 56px !important; }
	#kt_header .container-xxl { gap: .5rem !important; }         /* antes estava gap-3 (~1rem) */

	#kt_header .menu-link {
		padding: 6px 10px !important;                           /* antes: 10px 14px */
		font-size: 12px !important;                             /* antes: 14px */
		gap: 6px !important;
		border-radius: 8px !important;
		letter-spacing: .3px !important;
	}

	#kt_header .menu-link .fs-4,
	#kt_header .menu-link i.fs-4 {
		font-size: 1.05rem !important;                          /* encolhe ícones */
	}

	#kt_header .menu-sub { border-radius: 10px !important; }
	#kt_header .menu-sub .menu-link {
		padding: 6px 10px !important;
		font-size: 12px !important;
	}

	/* Botões do topo menores */
	#kt_header .btn-withdraw-clean,
	#kt_header .btn-boost-modern {
		padding: 8px 14px !important;
		font-size: 12px !important;
		border-radius: 8px !important;
	}

	/* Diminui espaço abaixo do header */
	#kt_toolbar {
		padding-top: .75rem !important;
		padding-bottom: .75rem !important;
	}

	/* Logo menor */
	#kt_header .header-logo img { height: 20px !important; }

	/* Evita que itens criem alturas extras */
	#kt_header .menu,
	#kt_header .header-menu { line-height: 1.1 !important; }

	/* Estilo do botão de saque (neon) */
	.btn-withdraw-clean {
		background: #1e1e2d;
		color: #00ffe1;
		border: 1px solid #00ffe1;
		padding: 10px 22px;
		border-radius: 8px;
		font-weight: 500;
		font-size: 14px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		transition: all 0.3s ease;
		box-shadow: inset 0 0 0 transparent;
	}

	.btn-withdraw-clean:hover {
		background-color: #00ffe1;
		color: #1e1e2d;
		box-shadow: 0 0 8px #00ffe1;
	}

	.header-logo img {
		filter: drop-shadow(0 0 4px #00ffe1);
	}

	/* Estilo principal dos itens do menu superior */
	.menu-link {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		font-size: 14px;
		color: #00f0ff !important;
		background: transparent;
		border-radius: 10px;
		padding: 10px 14px;
		transition: all 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		position: relative;
	}

	.menu-link:hover {
		background: rgba(0, 255, 255, 0.08);
		color: #fff !important;
		box-shadow: 0 0 12px rgba(0, 255, 255, 0.2);
		transform: translateY(-1px);
	}

	/* Ícones com efeito glow */
	.menu-link i {
		color: #00ffe1;
		transition: all 0.3s ease;
		text-shadow: 0 0 6px rgba(0,255,255,0.3);
	}

	/* Efeito ao passar o mouse no ícone */
	.menu-link:hover i {
		color: #ffffff;
		text-shadow: 0 0 10px #00ffff;
	}

	/* Submenu personalizado */
	.menu-sub {
		background: rgba(0, 0, 0, 0.85) !important;
		border: 1px solid rgba(0,255,255,0.1);
		border-radius: 12px;
		box-shadow: 0 0 20px rgba(0,255,255,0.08);
		backdrop-filter: blur(8px);
	}

	/* Itens do submenu */
	.menu-sub .menu-link {
		color: #b0f7ff !important;
		padding-left: 1.8rem;
	}

	.menu-sub .menu-link:hover {
		background: rgba(0,255,255,0.05);
		color: #ffffff !important;
		box-shadow: inset 0 0 4px rgba(0,255,255,0.1);
	}

	/* Ativo */
	.menu-item.menu-item-active > .menu-link {
		background: rgba(0, 255, 255, 0.15);
		color: #ffffff !important;
		box-shadow: 0 0 10px rgba(0,255,255,0.2) inset;
	}

	/* Botões especiais como Withdraw e Boosters */
	.btn-withdraw-clean {
		font-weight: 600;
		font-size: 14px;
		background: linear-gradient(90deg, #00ffe1 0%, #00d1ff 100%);
		color: #000;
		border: none;
		border-radius: 10px;
		padding: 12px 20px;
		transition: 0.3s ease;
		box-shadow: 0 0 10px rgba(0,255,255,0.3);
	}

	.btn-withdraw-clean:hover {
		transform: translateY(-2px);
		box-shadow: 0 0 15px rgba(0,255,255,0.6);
		color: #000 !important;
	}

	.btn-boost-futuristic {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 14px 28px;
		color: #0ff;
		background: linear-gradient(135deg, #0ff, #00d1ff);
		border: 1px solid rgba(0, 255, 255, 0.3);
		border-radius: 12px;
		font-weight: 700;
		font-size: 15px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		text-shadow: 0 0 4px #000;
		box-shadow: 0 0 12px rgba(0, 255, 255, 0.3);
		transition: all 0.3s ease;
		overflow-x: hidden;
		overflow-y: auto;
		z-index: 1;
	}

	.btn-boost-futuristic::before {
		content: '';
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, rgba(0, 255, 255, 0.25) 0%, transparent 70%);
		animation: pulse-glow 3s infinite ease-in-out;
		z-index: 0;
	}

	@@keyframes pulse-glow {
		0% { transform: scale(1); opacity: 0.4; }
		50% { transform: scale(1.2); opacity: 0.6; }
		100% { transform: scale(1); opacity: 0.4; }
	}

	.btn-boost-futuristic:hover {
		color: #000;
		background: linear-gradient(135deg, #00ffe1, #00aaff);
		box-shadow: 0 0 18px rgba(0, 255, 255, 0.5);
		transform: translateY(-2px);
	}

	.btn-boost-futuristic i {
		text-shadow: 0 0 8px #0ff;
	}

	.btn-boost-futuristic i {
		text-shadow: 0 0 6px #0ff;
		animation: blinkSatellite 1.5s infinite ease-in-out;
		transition: text-shadow 0.3s;
	}

	@@keyframes blinkSatellite {
		0% {
			opacity: 1;
			text-shadow: 0 0 6px #0ff;
		}
		50% {
			opacity: 0.3;
			text-shadow: 0 0 2px #0ff;
		}
		100% {
			opacity: 1;
			text-shadow: 0 0 6px #0ff;
		}
	}

	.btn-boost-modern {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 12px 26px;
		background: rgba(0, 255, 255, 0.05);
		border: 1px solid rgba(0, 255, 255, 0.2);
		border-radius: 12px;
		color: #00f0ff;
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		backdrop-filter: blur(6px);
		box-shadow: 0 0 10px rgba(0,255,255,0.05);
		transition: all 0.3s ease;
		position: relative;
		overflow-x: hidden;
		overflow-y: auto;
	}

	.btn-boost-modern:hover {
		background: rgba(0, 255, 255, 0.15);
		box-shadow: 0 0 18px rgba(0,255,255,0.2);
		color: #ffffff;
		transform: translateY(-2px);
	}

	.btn-boost-modern i {
		color: #00ffe1;
		animation: pulseIcon 2s infinite ease-in-out;
		transition: color 0.3s ease;
	}

	@@keyframes pulseIcon {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.2); }
	}
</style>

